## @file
#  SDP RAID DXE driver that implements software RAID for NVMe disks.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION               = 0x00010006
  BASE_NAME                 = SdpDxe
  FILE_GUID                 = 94ede63f-f211-4a6d-823c-17029ee97086
  MODULE_TYPE               = UEFI_DRIVER
  VERSION_STRING            = 1.0
  ENTRY_POINT               = SdpDxeEntryPoint

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OvmfPkg/OvmfPkg.dec

[Sources]
  SdpRaid.c
  SdpRaid.h

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  MemoryAllocationLib
  UefiLib
  DebugLib
  BaseLib
  BaseMemoryLib
  DevicePathLib
  PrintLib

[Protocols]
  gEfiDriverBindingProtocolGuid
  gEfiPciIoProtocolGuid
  gEfiComponentName2ProtocolGuid
  gEfiComponentNameProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiDiskIoProtocolGuid           ## PRODUCES (for virtual RAID devices)
  gEfiDevicePathProtocolGuid
  gSdpRaidDeviceGuid
  gSdpRaidVirtualDiskGuid          ## PRODUCES (tag to identify our virtual disks)

[Guids]
  gEfiEndOfDxeEventGroupGuid       ## CONSUMES (for diagnostics)
